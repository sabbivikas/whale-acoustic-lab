cff-version: 1.2.0
message: "If you use Whale Acoustic Lab, cite this software and the upstream scientific sources listed below."
title: "Whale Acoustic Lab"
type: software
version: 0.1.0
date-released: 2026-07-21
license: MIT
authors:
  - name: "Whale Acoustic Lab contributors"
repository-code: "https://github.com/sabbivikas/whale-acoustic-lab"
abstract: >-
  A browser and backend research interface for evidence-bounded exploration of
  sperm-whale click timing, probable codas, acoustic embeddings, researcher
  annotations, evaluation, corpus comparison, and deterministic art.
keywords:
  - bioacoustics
  - sperm whale
  - annotation
  - acoustic embeddings
  - reproducible research
